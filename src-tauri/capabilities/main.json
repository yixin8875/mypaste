{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local MyPaste windows may use only MyPaste commands and subscribe to events.",
  "local": true,
  "windows": ["main", "quick"],
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten",
    "allow-get-snapshot", "allow-get-item", "allow-search-items", "allow-update-item",
    "allow-purge-item", "allow-create-collection", "allow-update-settings",
    "allow-copy-item", "allow-get-image", "allow-get-thumbnail", "allow-paste-item", "allow-open-link",
    "allow-hide-quick-window", "allow-export-backup", "allow-import-backup",
    "allow-open-data-dir", "allow-set-data-dir",
    "allow-rename-collection", "allow-delete-collection", "allow-move-collection",
    "allow-update-items", "allow-add-to-collection", "allow-copy-item-variant",
    "allow-copy-item-format",
    "allow-data-usage", "allow-compact-database", "allow-set-autostart",
    "allow-set-collection-policy",
    "allow-start-sequence", "allow-sequence-status", "allow-sequence-next", "allow-stop-sequence",
    "allow-get-log-info", "allow-open-log-dir", "allow-export-diagnostics",
    "allow-restart-elevated",
    "updater:default", "process:allow-restart", "dialog:default"
  ]
}
